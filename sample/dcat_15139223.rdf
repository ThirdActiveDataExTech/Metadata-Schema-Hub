                <dct:title xml:lang="en">National wastewater discharge facility standard data</dct:title>
                
                <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2025-03-28</dct:modified>
                <dct:publisher>
                    <foaf:Organization>
                        
                        <foaf:name>지방자치단체</foaf:name>
                    </foaf:Organization>
                </dct:publisher>
                
                <dct:conformsTo >물환경보전법 제33조</dct:conformsTo>
                <dcat:theme>환경 - 폐기물</dcat:theme>
                <dcat:keyword xml:lang="kr">폐수,폐수배출,폐수배출사업장</dcat:keyword>
                <dcat:keyword xml:lang="en">wastewater,Wastewater discharge,Wastewater discharge facility</dcat:keyword>
                
                
                <dct:accrualPeriodicity>연간</dct:accrualPeriodicity>
